{
  "defaults": {
    "accept_timeout_s": 600,
    "max_attempts": 2,
    "retry_delay_s": 30,
    "agent_timeout_s": 3600
  },
  "workers": [
    {
      "name": "builtin-local",
      "provider": "openai",
      "model": "gpt-4o-mini",
      "api_base": "http://localhost:8000/v1",
      "api_key_env": "EXAMPLE_API_KEY",
      "enabled": true,
      "cli": "builtin",
      "max_turns": 32
    }
  ]
}
